{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Triage result (result.json)",
  "type": "object",
  "required": ["hypotheses", "remediation", "ticket"],
  "properties": {
    "no_incident_evident": {"type": "boolean", "description": "true if the data shows no real incident"},
    "hypotheses": {
      "type": "array", "description": "Ranked, most likely first",
      "items": {"type": "object", "required": ["rank", "title", "confidence", "evidence"], "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "services": {"type": "array", "items": {"type": "string"}, "description": "services this hypothesis involves (must exist)"},
        "evidence": {"type": "array", "items": {"type": "object", "required": ["ref"], "properties": {
          "ref": {"type": "string", "description": "log-0001234 | dep-000123 | deploy-4821 | metric:service/name | explain:q_id | slowq:q_id | jira:KEY | runbook:name | commit:<sha> | pr:<number> | run:<actions run id> | build:<ado build id>"},
          "quote": {"type": "string", "description": "verbatim excerpt (checked against the record)"}}}}}}
    },
    "uncertainty_notes": {"type": "string"},
    "data_gaps": {"type": "array", "items": {"type": "string"}, "description": "failed/partial/empty sources"},
    "assumptions": {"type": "array", "items": {"type": "string"}, "description": "e.g. timezone normalisation"},
    "verification": {"type": "object", "properties": {"status": {"enum": ["verified", "not_verified", "n/a"]}, "notes": {"type": "string"}}},
    "remediation": {"type": "object", "properties": {
      "summary": {"type": "string"}, "steps": {"type": "array", "items": {"type": "string"}},
      "reversible": {"type": "boolean"}, "requires_human_approval": {"type": "boolean"}}},
    "injection_flagged": {"type": "array", "items": {"type": "object", "properties": {
      "source": {"type": "string"}, "quote": {"type": "string"}, "note": {"type": "string"}}}},
    "out_of_scope_notes": {"type": "string"},
    "ticket": {"type": "object", "properties": {"id": {"type": "string"}, "url": {"type": "string"}}},
    "actions_taken": {"type": "array", "items": {"type": "string"}, "description": "everything actually done (reads, ticket creation). Do not list proposals."},
    "summary_markdown": {"type": "string"}
  }
}
